{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Backend (FastAPI)",
            "type": "debugpy",
            "request": "launch",
            "module": "uvicorn",
            "args": [
                "app.main:app",
                "--reload",
                "--port",
                "8000"
            ],
            "cwd": "${workspaceFolder}/ai-code-reviewer/backend",
            "python": "${workspaceFolder}/ai-code-reviewer/backend/venv/Scripts/python.exe"
        },
        {
            "name": "Frontend (Vite Dev)",
            "type": "node",
            "request": "launch",
            "runtimeExecutable": "npm",
            "runtimeArgs": [
                "run",
                "dev"
            ],
            "cwd": "${workspaceFolder}/ai-code-reviewer/frontend"
        }
    ]
}